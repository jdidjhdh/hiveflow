# ============================================================
# HiveFlow - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================================

# -------------------- LLM Configuration --------------------
# Provider: openai, anthropic, mock
HIVEFLOW_LLM_PROVIDER=openai
HIVEFLOW_LLM_MODEL=gpt-4o
HIVEFLOW_LLM_TEMPERATURE=0.2
HIVEFLOW_LLM_MAX_TOKENS=4096

# OpenAI API Key (required if HIVEFLOW_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (required if HIVEFLOW_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -------------------- Redis Configuration --------------------
# Optional: Used for distributed blackboard and caching
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# -------------------- Database Configuration --------------------
# Optional: Used for Studio persistence
DB_TYPE=sqlite
DB_URL=sqlite:///./hiveflow.db

# For PostgreSQL:
# DB_TYPE=postgresql
# DB_URL=postgresql://hiveflow:password@localhost:5432/hiveflow

# -------------------- Security Configuration --------------------
# Encryption key for blackboard (min 32 characters)
HIVEFLOW_ENCRYPTION_KEY=your-encryption-key-min-32-chars-long

# Enable input/output guards
HIVEFLOW_GUARD_ENABLED=true
HIVEFLOW_MAX_INPUT_LENGTH=10000

# -------------------- Studio Configuration --------------------
# Backend
HIVEFLOW_API_HOST=0.0.0.0
HIVEFLOW_API_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# -------------------- Agent Configuration --------------------
HIVEFLOW_AGENT_MAX_CONCURRENT=10
HIVEFLOW_AGENT_SCHEDULER_STRATEGY=least_loaded
HIVEFLOW_AGENT_HITL_TIMEOUT=300

# -------------------- Logging --------------------
HIVEFLOW_LOG_LEVEL=INFO
# HIVEFLOW_LOG_FILE=./logs/hiveflow.log
