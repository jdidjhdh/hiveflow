{
  "dashboard": {
    "id": null,
    "uid": "hiveflow-main",
    "title": "HiveFlow 核心指标仪表板",
    "tags": ["hiveflow", "orchestration", "agent"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "工作流执行率",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(hiveflow_workflows_completed[5m]) / rate(hiveflow_workflows_total[5m]) * 100",
            "legendFormat": "成功率 %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 2,
        "title": "活跃 Agent 数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "hiveflow_active_agents",
            "legendFormat": "Agent 数"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 3,
        "title": "任务队列大小",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "hiveflow_queue_size",
            "legendFormat": "队列深度"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "系统运行时间",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "hiveflow_process_uptime_seconds",
            "legendFormat": "运行时间"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 0
          }
        }
      },
      {
        "id": 5,
        "title": "工作流吞吐量 (5m 速率)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(hiveflow_workflows_total[5m])",
            "legendFormat": "总工作流"
          },
          {
            "expr": "rate(hiveflow_workflows_completed[5m])",
            "legendFormat": "成功"
          },
          {
            "expr": "rate(hiveflow_workflows_failed[5m])",
            "legendFormat": "失败"
          }
        ],
        "yaxes": [
          {"label": "工作流/秒", "format": "ops"}
        ]
      },
      {
        "id": 6,
        "title": "任务执行延迟分布",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(hiveflow_task_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.90, rate(hiveflow_task_duration_seconds_bucket[5m]))",
            "legendFormat": "P90"
          },
          {
            "expr": "histogram_quantile(0.99, rate(hiveflow_task_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "yaxes": [
          {"label": "延迟 (秒)", "format": "s"}
        ]
      },
      {
        "id": 7,
        "title": "错误类型分布",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "rate(hiveflow_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "stack": true,
        "yaxes": [
          {"label": "错误/秒", "format": "ops"}
        ]
      },
      {
        "id": 8,
        "title": "Agent 负载分布",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "hiveflow_worker_load",
            "legendFormat": "{{worker_id}}"
          }
        ],
        "yaxes": [
          {"label": "负载", "format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "黑板操作速率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(hiveflow_blackboard_operations[5m])",
            "legendFormat": "黑板操作/秒"
          }
        ],
        "yaxes": [
          {"label": "操作/秒", "format": "ops"}
        ]
      },
      {
        "id": 10,
        "title": "LLM 响应延迟",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(hiveflow_llm_response_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.90, rate(hiveflow_llm_response_duration_seconds_bucket[5m]))",
            "legendFormat": "P90"
          },
          {
            "expr": "histogram_quantile(0.99, rate(hiveflow_llm_response_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "yaxes": [
          {"label": "延迟 (秒)", "format": "s"}
        ]
      },
      {
        "id": 11,
        "title": "意图解析速率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "rate(hiveflow_intents_parsed[5m])",
            "legendFormat": "意图/秒"
          }
        ],
        "yaxes": [
          {"label": "意图/秒", "format": "ops"}
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    }
  },
  "folderId": 0,
  "overwrite": false,
  "message": "HiveFlow 核心指标仪表板 - 自动导入"
}
